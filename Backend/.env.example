# Copy to Backend/.env and REPLACE every CHANGE_ME value before deploying.
# Backend/.env must never be committed (see .gitignore).
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_SITE_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example

# Number of trusted reverse-proxy hops. 0 = direct exposure (X-Forwarded-For ignored).
# Set to 1 when running behind the bundled nginx / another single proxy.
TRUST_PROXY_HOPS=0

# XAMPP / MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ultradownloader_db

# Set to 1 only on an EMPTY database to auto-apply the idempotent schema.sql.
# The manual import (ultradownloader_xampp.sql) is also non-destructive.
AUTO_IMPORT_SQL=0

VAULT_STORAGE_DIR=./storage/vault
TEMP_EPHEMERAL_DIR=./storage/tmp
EXTRACTOR_TIMEOUT_MS=25000

# Secrets — generate your own, e.g. `openssl rand -hex 32` (64 hex chars for AES key).
JWT_ADMIN_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_USER_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
PADLOCK_TICKET_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
AES_256_VAULT_KEY=CHANGE_ME_64_hex_characters
ADMIN_TOTP_SECRET=CHANGE_ME_base32_totp_seed

# Admin credentials — no defaults are compiled into the application.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_PIN=CHANGE_ME_4_to_6_digit_pin

ADMIN_IP_ALLOWLIST=
ADMIN_MAX_FAILED_ATTEMPTS=3
ADMIN_BAN_DURATION_MINUTES=30
GUEST_DAILY_DOWNLOAD_LIMIT=50
USER_DAILY_DOWNLOAD_LIMIT=500
